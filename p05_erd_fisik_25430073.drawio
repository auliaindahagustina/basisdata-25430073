        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    petugas {\n        int id_petugas PK \&quot;AI (1 s.d. 10: Andi, Rian, Maya, Dian, Fajar, Siti, Reza, Tina, Bayu, Nisa)\&quot;\n        char kode_petugas \&quot;UNIQUE (ADM01 s.d. ADM10)\&quot;\n        varchar nama_petugas \&quot;NOT NULL\&quot;\n        enum peran_petugas \&quot;NOT NULL\&quot;\n        varchar no_telepon_petugas \&quot;NULL\&quot;\n    }\n\n    pelanggan {\n        int id_pelanggan PK \&quot;AI (1 s.d. 10: Budi, Siti, Ahmad, Dewi, Joko, Rina, Eko, Sri, Doni, Putri)\&quot;\n        char no_pelanggan \&quot;UNIQUE (PLG001 s.d. PLG010)\&quot;\n        char no_identitas_pelanggan \&quot;UNIQUE, NOT NULL (KTP/SIM)\&quot;\n        varchar nama_pelanggan \&quot;NOT NULL\&quot;\n        alamat_pelanggan alamat_pelanggan \&quot;NULL\&quot;\n        varchar no_hp_pelanggan \&quot;NULL\&quot;\n        date tgl_daftar_pelanggan \&quot;NOT NULL\&quot;\n    }\n\n    mobil {\n        int id_mobil PK \&quot;AI (1 s.d. 10: Avanza, Brio, Xenia, Xpander, Innova, Ertiga, Fortuner, Civic, Terios, Wuling)\&quot;\n        char kode_mobil \&quot;UNIQUE (MBL01 s.d. MBL10)\&quot;\n        varchar merk_mobil \&quot;NOT NULL\&quot;\n        char nomor_plat_mobil \&quot;UNIQUE, NOT NULL\&quot;\n        int tahun_mobil \&quot;NOT NULL\&quot;\n        decimal harga_sewa_mobil \&quot;CHECK &gt;= 0\&quot;\n        enum status_mobil \&quot;DEFAULT tersedia\&quot;\n    }\n\n    sewa {\n        int id_sewa PK \&quot;AI (1 s.d. 10 data transaksi nota sewa)\&quot;\n        char no_nota_sewa \&quot;UNIQUE, NOT NULL (NT001 s.d. NT010)\&quot;\n        datetime tgl_sewa \&quot;NOT NULL\&quot;\n        int id_petugas FK \&quot;-&gt; petugas\&quot;\n        int id_pelanggan FK \&quot;-&gt; pelanggan\&quot;\n        decimal total_biaya_sewa \&quot;CHECK &gt;= 0\&quot;\n    }\n\n    detail_sewa {\n        int id_sewa PK,FK \&quot;-&gt; sewa (1 s.d. 10)\&quot;\n        int id_mobil PK,FK \&quot;-&gt; mobil (1 s.d. 10)\&quot;\n        smallint lama_sewa_hari \&quot;CHECK &gt; 0\&quot;\n        decimal harga_satuan_sewa \&quot;CHECK &gt;= 0\&quot;\n    }\n\n    petugas ||--o{ sewa : \&quot;melayani\&quot;\n    pelanggan ||--o{ sewa : \&quot;melakukan\&quot;\n    sewa ||--|{ detail_sewa : \&quot;memiliki\&quot;\n    mobil ||--o{ detail_sewa : \&quot;disewa dalam\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Rv-PSTB2v2Zs6LhAPhHU-1">
